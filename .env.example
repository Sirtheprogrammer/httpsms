# Copy to .env and fill in. docker compose reads .env automatically.
#   cp .env.example .env

# Encrypts users' AI provider keys at rest. Any long random string, e.g.:
#   openssl rand -hex 32
# Leave empty to auto-generate data/secret.key on first start (back that file up).
# Never change it once keys are stored: existing keys would become unreadable.
SECRET_KEY=

# Optional admin Bearer token for scripts (acts as the first admin account).
# Leave empty to disable. Never use a guessable value.
MASTER_SECRET=

# Only needed when running the server outside Docker (make run):
# PORT=8080
# DB_PATH=./data/httpsms.db
# OTA_DIR=./data/ota
# WEB_DIR=../dashboard/dist
